// =============================================================================
// LINKCOMMERCE — schema.prisma
// Multi-tenant simples: isolamento lógico por lojaId (sem schemas separados,
// adequado ao MVP descrito no documento LinkCommerce — ADR-002 fica para Fase 3
// quando se migrar para isolamento por schema/cluster nos planos Enterprise).
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// PLATAFORMA / SUBSCRIÇÃO
// Secção exigida no fluxo: "os clientes para usufruírem dos nossos serviços
// têm que escolher o plano que queiram pagar" (ver Planos em LinkCommerce §11.1)
// -----------------------------------------------------------------------------

enum CicloFaturacao {
  MENSAL
  ANUAL
}

enum StatusSubscricao {
  TRIAL
  PENDENTE_TRANSFERENCIA
  ATIVA
  EM_FALTA
  CANCELADA
}

model Plano {
  id                 String   @id @default(cuid())
  nome               String   @unique // "Free", "Starter", "Growth", "Enterprise"
  slug               String   @unique
  precoMensal        Decimal  @db.Decimal(10, 2)
  comissaoPercentual Decimal  @db.Decimal(5, 2) // % sobre cada venda
  limiteProdutos     Int? // null = ilimitado
  permiteDominioProprio Boolean @default(false)
  permiteApiAccess   Boolean  @default(false)
  permiteWhiteLabel  Boolean  @default(false)
  stripePriceId      String?  // Stripe Price ID para subscrição mensal (null = Free)
  ordem              Int      @default(0) // para ordenar na página de pricing
  createdAt          DateTime @default(now())

  lojas       Loja[]
  subscricoes Subscricao[]

  @@map("planos")
}

model Subscricao {
  id              String           @id @default(cuid())
  lojaId          String           @unique
  loja            Loja             @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  planoId         String
  plano           Plano            @relation(fields: [planoId], references: [id])
  status          StatusSubscricao @default(TRIAL)
  cicloFaturacao  CicloFaturacao   @default(MENSAL)
  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  trialFimEm      DateTime?
  proximaCobranca DateTime?
  comprovanteUrl  String?   // URL do comprovativo de transferência bancária (AOA)
  moedaPagamento  String?   // "EUR" ou "AOA" — registo da moeda usada na subscrição
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("subscricoes")
}

// -----------------------------------------------------------------------------
// IDENTIDADE / AUTH (NextAuth.js — Prisma Adapter)
// -----------------------------------------------------------------------------

enum RoleUtilizador {
  ADMIN_PLATAFORMA // equipa interna LinkCommerce, gere todos os tenants
  LOJISTA          // dono/gestor de uma Loja
  OPERADOR_POS     // acesso restrito apenas à rota /pos
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?         // login email/senha (Google passa por OAuthAccount)
  role          RoleUtilizador  @default(LOJISTA)

  lojaId        String?
  loja          Loja?           @relation(fields: [lojaId], references: [id])

  accounts      Account[]
  sessions      Session[]

  createdAt     DateTime        @default(now())

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -----------------------------------------------------------------------------
// LOJA (TENANT)
// -----------------------------------------------------------------------------

model Loja {
  id            String   @id @default(cuid())
  nome          String
  subdominio    String   @unique
  dominioProprio String? @unique
  corPrimaria   String   @default("#0F172A")
  corSecundaria String   @default("#3B82F6")
  logotipoUrl   String?
  tipoNegocio   String? // ex: "moda feminina" — usado pela sugestão de IA no onboarding
  templateBase  String   @default("produtos_fisicos") // 'produtos_fisicos' | 'produtos_digitais'
  publicada     Boolean  @default(true) // loja fica pública imediatamente após config
  moeda         String   @default("EUR") // EUR | USD | AOA
  nif           String?  // Número de Identificação Fiscal da loja
  moradaFiscal  String?  // Morada completa da loja para faturas
  telefoneWA    String?  // Número WhatsApp da loja (ex: +244900000000)

  planoId       String?
  plano         Plano?   @relation(fields: [planoId], references: [id])
  subscricao    Subscricao?

  utilizadores     User[]
  produtos         Produto[]
  pedidos          Pedido[]
  pagamentos       Pagamento[]
  clientes         Cliente[]
  cupoes           Cupao[]
  metodosPagamento MetodoPagamentoLoja[]
  metodosEnvio     MetodoEnvio[]
  zonasEntrega     ZonaEntrega[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("lojas")
}

// -----------------------------------------------------------------------------
// PAGAMENTOS & ENVIOS (configuração por loja)
// -----------------------------------------------------------------------------

enum ProvedorPagamento {
  STRIPE
  MBWAY
  MULTICAIXA
}

model MetodoPagamentoLoja {
  id         String            @id @default(cuid())
  lojaId     String
  loja       Loja              @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  provedor   ProvedorPagamento
  ativo      Boolean           @default(false)
  configJson Json? // chaves públicas, IDs de conta conectada, etc. (segredos nunca aqui)

  @@unique([lojaId, provedor])
  @@map("metodos_pagamento_loja")
}

enum TipoEnvio {
  TAXA_FIXA
  POR_PESO
  RECOLHA_NA_LOJA
}

model MetodoEnvio {
  id        String    @id @default(cuid())
  lojaId    String
  loja      Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  nome      String
  tipo      TipoEnvio
  valorBase Decimal   @db.Decimal(10, 2)
  valorPorKg Decimal? @db.Decimal(10, 2)
  ativo     Boolean   @default(true)

  @@map("metodos_envio")
}

model ZonaEntrega {
  id        String   @id @default(cuid())
  lojaId    String
  loja      Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  nome      String   // ex: "Talatona", "Viana", "Luanda Centro"
  preco     Decimal  @db.Decimal(10, 2)
  prazo     String?  // ex: "1-2 dias", "Mesmo dia"
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  pedidos   Pedido[]

  @@map("zonas_entrega")
}

// -----------------------------------------------------------------------------
// CATÁLOGO
// -----------------------------------------------------------------------------

model Produto {
  id               String   @id @default(cuid())
  lojaId           String
  loja             Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  titulo           String
  descricao        String?  @db.Text
  preco            Decimal  @db.Decimal(10, 2)
  sku              String?
  imagemUrl        String?
  stock            Int      @default(0)
  stockReservado   Int      @default(0)
  stockMinimo      Int      @default(0)
  permitirOverselling Boolean @default(false)
  ativo            Boolean  @default(true)

  variantes        Variante[]
  itensPedido      ItemPedido[]
  movimentosStock  MovimentoStock[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([lojaId])
  @@index([lojaId, stock])
  @@map("produtos")
}

model Variante {
  id              String   @id @default(cuid())
  produtoId       String
  produto         Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  nomeOpcao       String   // ex: "Azul / M"
  sku             String?
  precoExtra      Decimal  @default(0) @db.Decimal(10, 2)
  stock           Int      @default(0)
  stockReservado  Int      @default(0)

  itensPedido     ItemPedido[]
  movimentosStock MovimentoStock[]

  @@map("variantes")
}

// -----------------------------------------------------------------------------
// CLIENTES
// -----------------------------------------------------------------------------

model Cliente {
  id        String   @id @default(cuid())
  lojaId    String
  loja      Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  email     String
  nome      String?
  telefone  String?
  morada    Json?

  pedidos   Pedido[]

  createdAt DateTime @default(now())

  @@unique([lojaId, email])
  @@map("clientes")
}

// -----------------------------------------------------------------------------
// PAGAMENTOS — entidade separada do Pedido (ponto 11 do PROMPT MESTRE)
// Um pedido pode ter múltiplos pagamentos (tentativa falhada + nova tentativa,
// reembolso parcial, etc.). A idempotência é garantida pelo campo eventoId.
// -----------------------------------------------------------------------------

enum MetodoPagamento {
  CARTAO        // Stripe card
  MBWAY         // Stripe MB Way
  MULTIBANCO    // Stripe Multibanco
  PAYPAL        // Stripe PayPal
  MULTICAIXA    // Multicaixa Express (directo, sem Stripe)
  NA_ENTREGA    // Pagamento na entrega
  TRANSFERENCIA // Transferência bancária
  DESCONHECIDO  // fallback / POS / dev mode
}

enum StatusPagamento {
  PENDENTE    // iniciado, aguarda confirmação do provider
  CONFIRMADO  // confirmado via webhook ou manualmente
  FALHADO     // falhou no provider
  EXPIRADO    // abandonado / expirou sem pagamento
  REEMBOLSADO // reembolsado (total ou parcial)
  CANCELADO   // cancelado antes de tentativa de pagamento
}

model Pagamento {
  id             String          @id @default(cuid())
  lojaId         String
  loja           Loja            @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  pedidoId       String
  pedido         Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  metodo         MetodoPagamento @default(DESCONHECIDO)
  status         StatusPagamento @default(PENDENTE)
  valor          Decimal         @db.Decimal(10, 2)
  moeda          String          @default("AOA")
  // referencia: Stripe session/payment intent ID, referência Multicaixa, etc.
  referencia     String?
  // provedor: "stripe" | "multicaixa" | "manual"
  provedor       String?
  // comprovanteUrl: URL do comprovativo enviado pelo cliente (Multicaixa/transferência)
  comprovanteUrl String?
  // eventoId: ID único do evento do provider → garantia de idempotência
  eventoId       String?         @unique
  metadata       Json?
  criadoEm      DateTime        @default(now())
  atualizadoEm  DateTime        @updatedAt

  @@index([lojaId])
  @@index([pedidoId])
  @@map("pagamentos")
}

// -----------------------------------------------------------------------------
// PEDIDOS (unificado online + POS, incl. POS offline sincronizado)
// -----------------------------------------------------------------------------

enum StatusPedido {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

// -----------------------------------------------------------------------------
// INVENTÁRIO — movimentos de stock auditáveis
// -----------------------------------------------------------------------------

enum TipoMovimentoStock {
  RESERVA           // checkout iniciado → stockReservado++
  RESERVA_EXPIRADA  // pedido abandonado/expirado → stockReservado--
  VENDA             // pagamento confirmado → stock--, stockReservado--
  CANCELAMENTO      // pedido cancelado manualmente → stockReservado--
  REPOSICAO         // lojista adiciona stock manualmente → stock++
  AJUSTE            // correcção manual (pode ser positiva ou negativa)
  DEVOLUCAO         // cliente devolveu produto → stock++
}

model MovimentoStock {
  id          String              @id @default(cuid())
  lojaId      String
  produtoId   String
  produto     Produto             @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  varianteId  String?
  variante    Variante?           @relation(fields: [varianteId], references: [id])
  tipo        TipoMovimentoStock
  quantidade  Int                 // positivo = entrada, negativo = saída
  pedidoId    String?             // referência ao pedido quando aplicável
  nota        String?             // descrição legível do movimento
  criadoEm   DateTime            @default(now())

  @@index([lojaId, produtoId])
  @@index([pedidoId])
  @@map("movimentos_stock")
}

enum CanalPedido {
  ONLINE
  POS
}

model Pedido {
  id            String       @id @default(cuid())
  lojaId        String
  loja          Loja         @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  clienteId     String?
  cliente       Cliente?     @relation(fields: [clienteId], references: [id])
  clienteEmail  String
  clienteNome   String?
  morada        Json?

  subtotal      Decimal      @db.Decimal(10, 2)
  desconto      Decimal      @default(0) @db.Decimal(10, 2)
  total         Decimal      @db.Decimal(10, 2)
  status        StatusPedido @default(PENDING)
  channel       CanalPedido  @default(ONLINE)

  // Suporte à sincronização offline do POS (IndexedDB -> servidor)
  clientUuid    String?      @unique // UUID gerado no browser/tablet antes de existir ligação
  sincronizadoEm DateTime?

  cupaoId       String?
  cupao         Cupao?       @relation(fields: [cupaoId], references: [id])
  zonaEntregaId  String?
  zonaEntrega    ZonaEntrega? @relation(fields: [zonaEntregaId], references: [id])

  itens         ItemPedido[]
  pagamentos    Pagamento[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([lojaId, status])
  @@map("pedidos")
}

model ItemPedido {
  id            String    @id @default(cuid())
  pedidoId      String
  pedido        Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto   @relation(fields: [produtoId], references: [id])
  varianteId    String?
  variante      Variante? @relation(fields: [varianteId], references: [id])
  quantidade    Int
  precoUnitario Decimal   @db.Decimal(10, 2)

  @@map("itens_pedido")
}

// -----------------------------------------------------------------------------
// MARKETING
// -----------------------------------------------------------------------------

enum TipoCupao {
  PERCENTAGEM
  VALOR_FIXO
}

// -----------------------------------------------------------------------------
// ANALYTICS DA PLATAFORMA (agregado, sem dados pessoais)
// Regista eventos de utilização real para cálculo de métricas públicas.
// Nunca guardar: IP, user-agent, email, nome, sessão ou qualquer dado pessoal.
// -----------------------------------------------------------------------------

model EventoPlataforma {
  id      String   @id @default(cuid())
  // 'store_view' | 'cta_click'
  tipo    String
  // lojaId agregado — permite saber quantas lojas têm actividade, mas nunca exposto individualmente
  lojaId  String?
  // Apenas a data (sem hora) — granularidade diária, sem timestamp preciso
  dia     DateTime @db.Date

  @@index([tipo, dia])
  @@map("eventos_plataforma")
}

model Cupao {
  id        String     @id @default(cuid())
  lojaId    String
  loja      Loja       @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  codigo    String
  tipo      TipoCupao
  valor     Decimal    @db.Decimal(10, 2)
  validade  DateTime?
  ativo     Boolean    @default(true)
  usosMaximos Int?
  usosAtuais  Int      @default(0)

  pedidos   Pedido[]

  @@unique([lojaId, codigo])
  @@map("cupoes")
}
